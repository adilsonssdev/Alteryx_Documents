    <Node ToolID="3">
      <GuiSettings Plugin="JupyterCode">
        <Position x="294" y="282" />
      </GuiSettings>
      <Properties>
        <Configuration>
          <productionModeScript>#################################
from ayx import Alteryx
from ayx import Package
import os,sys

data = Alteryx.read("#1")

tempPath = os.getcwd()

for i in range(len(data.index)):
    sourceDir = data['Directory'][i]
    os.chdir(sourceDir) 
    sourceFile = data['FileName'][i]
    lib = sourceFile.split("-")[0].lower()
    installType = " --user" if (data['InstallType'][i]=="USER") else ''
    Package.installPackages(package=lib, install_type="install --no-index --find-links={0}{1}".format(sourceFile,installType))

os.chdir(tempPath)</productionModeScript>
